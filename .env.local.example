# Gemini API Key & Model (Server-side only)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Valid active models: gemini-2.5-flash (recommended), gemini-2.0-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Supabase Configuration
# Found in Project Settings > API in your Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
